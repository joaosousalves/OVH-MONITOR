[Unit]
Description=Watchdog for OVHcloud KS-LE-6 stock and commercial monitoring (health email only)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=/etc/ovh-ksle-monitor.env
ExecStart=/usr/bin/python3 /opt/ovh-ksle-monitor/ksle_monitor.py --health-check
StateDirectory=ovh-ksle-health
StateDirectoryMode=0700
TimeoutStartSec=90
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
NoNewPrivileges=true
