# MANUAL cart quotation only. Not loaded by the stock-monitor service or timer.
# These AK/AS/CK credentials must have the restricted temporary-cart permissions.
# NEVER commit this populated file to GitHub or paste its values into chat.
OVH_APPLICATION_KEY=REPLACE_WITH_APPLICATION_KEY
OVH_APPLICATION_SECRET=REPLACE_WITH_APPLICATION_SECRET
OVH_CONSUMER_KEY=REPLACE_WITH_CONSUMER_KEY
# Leave OVH_TOKEN unset when using the three keys.

# Phase B: purchase readiness preview. No checkout code exists in this release.
# Add the same variables to the EXISTING /etc/ovh-ksle-order.env;
# do not overwrite a file already containing your real API credentials.
OVH_AUTO_BUY_ENABLED=false
# Required before running --purchase-preview: absolute maximum FIRST charge,
# inclusive of VAT and setup fees (EUR). Example only, NOT consent to buy.
OVH_AUTO_BUY_MAX_TOTAL_EUR=45.00
# In order of preference; values outside this list are never considered.
OVH_AUTO_BUY_ALLOWED_DATACENTERS=bhs,fra,gra,lon,rbx,sbg,waw
# Private, root-owned journal to block later repeated/uncertain purchases.
OVH_AUTO_BUY_JOURNAL=/var/lib/ovh-ksle-purchase/intent.json

# Phase C: credentials MAY optionally be rotated to include only these
# additional GET rights for --check-payment-readiness:
# GET /me/payment/method
# GET /me/payment/method/*
# GET /me/order/*/status  (future read-only reconciliation)
# Do NOT grant POST /order/cart/*/checkout or POST /me/order/*/pay yet.
# The --simulate-checkout command is fully offline and does not need a key.
# Phase C does NOT implement live checkout or automated email.

# KS-LE-6 only; at most TWO total servers, same or different storage.
# 128GB RAM in every eligible configuration. 1 or 2; never more.
OVH_AUTO_BUY_MAX_SERVERS=2
# Shared two-slot ledger for future checkout, NEVER clear it after a timeout.
OVH_AUTO_BUY_QUOTA_JOURNAL=/var/lib/ovh-ksle-purchase/purchases-v2.json
# Ordered disk preferences are currently defined in purchase_guard.py:
# 1. 2x512GB NVMe + 2x4TB HDD (original preference)
# 2. 2x1.92TB NVMe
# 3. 3x1TB NVMe
# 4. 4x960GB SATA SSD
# OVH_AUTO_BUY_ALLOWED_DATACENTERS must contain only:
# bhs (Canada), fra (Germany), gra/rbx/sbg (France), lon (UK), waw (Poland).
# Alternate disk layouts remain preview-only until explicitly approved.
# Phase E: --purchase-preflight is a MANUAL temporary-cart quote plus\n# GET-only default payment check. It never places an order, reserves a\n# quota slot, or grants checkout/payment scopes.\n# A VAT-inclusive monthly renewal cap has not been approved.\n# No checkout is implemented or enabled by these settings.
